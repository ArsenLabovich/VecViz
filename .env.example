# OpenAI API key (required unless USE_LOCAL_EMBEDDINGS=true)
OPENAI_API_KEY=sk-...

# Set to true to use local sentence-transformers (no API key needed, slower)
USE_LOCAL_EMBEDDINGS=false

# Dimensionality reduction method: umap | pacmap
REDUCTION_METHOD=umap

# Port exposed on the host for the frontend
APP_PORT=80

# Logging level: debug | info | warning | error
LOG_LEVEL=info
